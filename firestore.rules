rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function để kiểm tra user đã đăng nhập
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function để kiểm tra user có phải là chủ sở hữu không
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function để kiểm tra user có phải là admin không
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Collection: court_locations
    match /court_locations/{courtId} {
      // Cho phép mọi người đọc sân
      allow read: if isAuthenticated();
      // Chỉ admin mới có thể tạo, cập nhật, xóa sân
      allow write: if isAdmin();
    }
    
    // Collection: bookings
    match /bookings/{bookingId} {
      // User có thể đọc booking của chính họ
      // HOẶC đọc tất cả bookings (để xem lịch sân) - cần thiết cho màn hình chọn sân
      // Admin có thể đọc tất cả
      allow read: if isAuthenticated();
      // User có thể tạo booking cho chính họ
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // User có thể xóa booking của chính họ, admin có thể xóa bất kỳ
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Chỉ admin mới có thể cập nhật booking
      allow update: if isAdmin();
    }
    
    // Collection: notifications
    match /notifications/{notificationId} {
      // User chỉ có thể đọc notifications của chính họ
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // User có thể tạo notifications cho chính họ (hoặc system tạo cho user)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // User có thể cập nhật notifications của chính họ (đánh dấu đã đọc)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // User có thể xóa notifications của chính họ
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Collection: users
    match /users/{userId} {
      // User có thể đọc thông tin của chính họ
      // Admin có thể đọc tất cả
      allow read: if isAuthenticated() && (
        userId == request.auth.uid ||
        isAdmin()
      );

      // Chat History
      match /chat_history/{messageId} {
        allow read, write: if isAuthenticated() && userId == request.auth.uid;
      }

      // User có thể cập nhật thông tin của chính họ
      // Admin có thể cập nhật bất kỳ user nào
      allow update: if isAuthenticated() && (
        userId == request.auth.uid ||
        isAdmin()
      );
      // Chỉ admin mới có thể tạo/xóa user
      allow create, delete: if isAdmin();
    }
  }
}

